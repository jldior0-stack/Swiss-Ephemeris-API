# Path to Swiss Ephemeris .se files (containing ephe/ directory with .se files)
EPHE_PATH=./ephe

# Server binding
HOST=0.0.0.0
PORT=8000

# CORS allowed origins (comma-separated, use * for all)
CORS_ORIGINS=*

# Public source for the exact version served over the network (AGPL requirement)
SOURCE_URL=https://github.com/jldior0-stack/Swiss-Ephemeris-API
